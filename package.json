{
  "name": "sbh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:core",
    "build:core": "mkdir -p src-tauri/binaries && bun build --compile --target=bun-linux-x64 core/index.ts --outfile src-tauri/binaries/sbh-core",
    "preview": "vite preview",
    "test": "vitest run",
    "core": "node --experimental-strip-types core/index.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "preact": "^10.29.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.2",
    "happy-dom": "^21.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
