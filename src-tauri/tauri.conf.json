{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SBH",
  "version": "0.1.0",
  "identifier": "dev.ran.sbh",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["binaries/sbh-core"],
    "linux": {
      "deb": {
        "files": {
          "/etc/sbh/capabilities.toml": "../examples/capabilities.toml"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
